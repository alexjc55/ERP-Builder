{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:settings": "tsx --test src/lib/app-settings-validation.test.ts",
    "test:text-direction": "tsx --test src/lib/text-direction.test.ts",
    "test:text-direction-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/text-direction.db.test.ts",
    "test:formula-totals": "tsx --test src/lib/formula-column-total.test.ts",
    "test:formula-totals-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/formula-column-totals.db.test.ts",
    "test:formula-group-archive-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/formula-group-archive.db.test.ts",
    "test:dashboard-chart-formulas-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/dashboard-chart-formulas.db.test.ts",
    "test:dashboard-formula-metrics-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/dashboard-formula-metrics.db.test.ts",
    "test:pivot-formula-tags-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/pivot-formula-tags.db.test.ts",
    "test:webhooks": "tsx --test src/lib/automation-webhook-display.test.ts",
    "test:automation-triggers": "tsx --test src/lib/automation-triggers.test.ts",
    "test:webhooks-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/automation-webhook-payload.db.test.ts",
    "test:lifecycle": "tsx --test src/lib/bounded-ttl-cache.test.ts src/lib/collaboration.test.ts src/routes/roles-agent-cache-wiring.test.ts",
    "test:pivot-affix": "tsx --test src/routes/pivot-display-affix.test.ts",
    "test:related-status-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/automation-related-status.db.test.ts",
    "test:automation-pool-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/automation-pool-starvation.db.test.ts",
    "test:relation-selection-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/lib/relation-selection.db.test.ts",
    "test:inbound-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/inbound-integrations.db.test.ts",
    "test:user-sessions-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/user-sessions.db.test.ts",
    "test:drive-disconnect-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/drive-disconnect.db.test.ts",
    "test:document-orphan-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/document-generation-orphan.db.test.ts",
    "test:import-status-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/import-status-permissions.db.test.ts",
    "test:page-select-status-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/page-select-status-sync.db.test.ts",
    "test:automation-folders-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/automation-folders.db.test.ts",
    "test:tags-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/tags.db.test.ts",
    "test:kanban-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/kanban.db.test.ts",
    "test:dashboard-status-tags-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/routes/dashboard-status-tags.db.test.ts",
    "test:permissions-role-context-db": "bash ../../scripts/with-validation-lock.sh tsx --test --test-concurrency=1 src/middlewares/permissions-role-context.db.test.ts",
    "test:documents": "tsx --test src/lib/document-docx.test.ts src/lib/document-generation-validation.test.ts src/lib/document-multipart.test.ts src/lib/gdrive-file-reference-lock.test.ts",
    "test:memory-diagnostics": "tsx --test src/lib/memory-diagnostics.test.ts",
    "test:server-lifecycle": "tsx --test src/lib/server-lifecycle.test.ts src/lib/collaboration.test.ts",
    "diagnostics:memory:repro": "tsx src/lib/memory-diagnostics.repro.ts",
    "smoke:concurrency": "pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/src/concurrency-smoke.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/formula": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
